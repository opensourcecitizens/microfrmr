# Dockerfile

# Use an official mtini.io/nodejdk17androidndk runtime as a parent image
# Build: docker buildx build . -t prelimtek/mcrfrmr:0.0.1-arm64 -f ./ui/docker/mcrfrmr-Dockerfile --platform linux/arm64
# use this after pushing -> FROM prelimtek/nodejdk17androidndk:0.0.1-amd64
# FROM prelimtek/nodejdk17androidndk:0.0.1-arm64
# FROM  mtini.io/nodejdk17androidndk:0.0.1-arm64-v86
FROM  mtini.io/nodejdk17androidndk:0.0.1-arm64

RUN apt-get update
RUN apt-get install -y build-essential checkinstall libssl-dev

SHELL ["/bin/bash", "--login", "-c"]

# Set the working directory to /app
WORKDIR /app

# Copy the entire app directory to the working directory
ADD ./ui .

# Install app dependencies
#RUN npm install
RUN yarn install

# Build the app for production

# build project - android and ios
RUN npx react-native build-android
# RUN npx react-native build-ios

# output apk will be contained in ./android/app/build/outputs/apk(bundle)/debug/app-debug.apk

# show content
CMD ls -l ./android/app/build/outputs/apk/app-debug.apk

# Expose port 8081 for the React Native packager
EXPOSE 8081 8082 8083

# Start the app

# vanilla
CMD ["npx", "react-native", "run-android"]